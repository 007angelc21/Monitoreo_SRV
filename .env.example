# === Proyecto ===
COMPOSE_PROJECT_NAME=monitoreo_srv
TZ=America/Mexico_City

# === Postgres ===
POSTGRES_DB=monitoreo_srv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
# URL interna (servicio docker). Para dev local con tu dato usa:
# NOTA: el sufijo ?schema=public es sintaxis Prisma, SQLAlchemy lo ignora/limpia solo.
DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@db:5432/monitoreo_srv

# === Backend ===
SECRET_KEY=cambiar-por-64-hex-aleatorios
FERNET_KEY=cambiar-por-clave-fernet-generada-con-scripts-gen-fernet.py
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://localhost,http://localhost:5173
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# === SMTP Email ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=monitoreo@tu-empresa.com
SMTP_TLS=true

# === Frontend ===
VITE_API_URL=http://localhost:8000

# === Caddy / Grafana ===
DOMAIN=localhost
GRAFANA_ADMIN_PASSWORD=CAMBIAR_TAMBIEN

# === Histórico en PG ===
METRICS_RETENTION_DAYS=400
